# RightGo Backend Environment Variables (Team ZENOVA - Tech-Triathlon 2026)

# Supabase PostgreSQL Connection String (Transaction Pooler port 6543 or Session port 5432)
# Example: postgresql://postgres.your-project-id:your-supabase-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Frontend URL & CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Competition Dataset Directory
RIGHTGO_DATA_DIR=../data

# Demo In-App OTP Flag
RIGHTGO_DEMO_OTP_IN_APP=true

# Security
SECRET_KEY=rightgo-tech-triathlon-2026-super-secret-key-zenova
DEBUG=true
ENVIRONMENT=development
