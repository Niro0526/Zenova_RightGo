# RightGo backend environment (placeholders only). Copy to Server/.env for non-Docker runs.

# PostgreSQL connection string (Supabase pooler/direct, or a local PostgreSQL).
# If left as this placeholder the API falls back to a local SQLite file (rightgo_dev.db) for development.
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Directory containing the confidential competition CSVs (searched recursively).
RIGHTGO_DATA_DIR=../data

# Show OTP in the driver app for demos.
RIGHTGO_DEMO_OTP_IN_APP=true
# Pre-seed a canned, already-departed demo run (not a valid plan). Leave false.
RIGHTGO_SEED_DEMO_RUN=false

# Optional: Supabase Storage for evidence uploads (falls back to ./storage_files when unset).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SECRET_KEY=change-me
DEBUG=true
ENVIRONMENT=development
