# RightGo local Docker Compose settings (placeholders only - copy to .env and edit).
# Never commit .env. Production (EC2 + Supabase) uses its own environment, not this file.

# --- Local PostgreSQL container ---
POSTGRES_DB=rightgo
POSTGRES_USER=rightgo
POSTGRES_PASSWORD=change-me-local-only

# --- Backend ---
SECRET_KEY=change-me
RIGHTGO_DEMO_OTP_IN_APP=true
# Set to false only to start the API without the dataset (reference data will NOT be seeded).
REQUIRE_DATASET=true

# --- Host ports (change to run a second, isolated stack side by side) ---
DB_PORT=5432
BACKEND_PORT=8000
CLIENT_PORT=3000

# --- Non-Docker runs (npm run dev / uvicorn): see Server/.env.example and Client/.env.example ---
